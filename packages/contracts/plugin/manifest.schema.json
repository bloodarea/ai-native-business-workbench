{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AINBW Plugin Manifest v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "business",
        "utility",
        "integration"
      ]
    },
    "status": {
      "enum": [
        "builtin",
        "planned",
        "experimental"
      ]
    },
    "contributions": {
      "type": "object"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
