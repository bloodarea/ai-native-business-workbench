{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement (draft)",
  "type": "object",
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "done"
      ]
    }
  }
}
