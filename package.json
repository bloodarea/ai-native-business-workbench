{
  "name": "ainbw-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "AI Native Business Workbench first engineering baseline",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=20"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @ainbw/web",
    "dev:desktop": "npm run dev -w @ainbw/desktop",
    "dev:core": "go run ./cmd/ainbw-core",
    "build:web": "npm run build -w @ainbw/web",
    "build:core": "go build -o bin/ainbw-core ./cmd/ainbw-core",
    "build:desktop": "npm run build -w @ainbw/desktop",
    "test:core": "go test ./...",
    "check": "npm run test:core && npm run build:web",
    "start:core": "go run ./cmd/ainbw-core --web-dir apps/web/dist"
  }
}
